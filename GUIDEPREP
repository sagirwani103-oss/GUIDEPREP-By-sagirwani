    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        // Toast Notification System
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-message');
            const icon = document.getElementById('toast-icon');
            
            msg.textContent = message;
            if (isError) {
                icon.className = 'fa-solid fa-triangle-exclamation text-accentRed text-lg';
            } else {
                icon.className = 'fa-solid fa-circle-check text-accentRed text-lg';
            }

            toast.classList.remove('translate-y-[-200%]');
            toast.classList.add('translate-y-0');

            setTimeout(() => {
                toast.classList.remove('translate-y-0');
                toast.classList.add('translate-y-[-200%]');
            }, 3000);
        }

        // Password Visibility Toggle
        function togglePasswordVisibility() {
            const pwd = document.getElementById('password-input');
            const icon = document.getElementById('eye-icon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'fa-solid fa-eye text-accentRed';
            } else {
                pwd.type = 'password';
                icon.className = 'fa-solid fa-eye-slash';
            }
        }

        // Auth Mock Handlers
        let isSignUpMode = false;
        function toggleAuthMode() {
            isSignUpMode = !isSignUpMode;
            const title = document.querySelector('#auth-screen h2');
            const subtitle = document.querySelector('#auth-screen p.text-xs');
            const switchText = document.getElementById('auth-switch-text');
            const loginBtnText = document.querySelector('#login-form button[type="submit"] span');

            if (isSignUpMode) {
                title.textContent = 'Create Account';
                subtitle.textContent = 'Join GuidePrep for smart learning';
                switchText.textContent = 'Login';
                loginBtnText.textContent = 'Sign Up';
            } else {
                title.textContent = 'Welcome Back!';
                subtitle.textContent = 'Login to continue your learning journey';
                switchText.textContent = 'Sign Up';
                loginBtnText.textContent = 'Login';
            }
        }

        function handleLogin(e) {
            e.preventDefault();
            const username = document.getElementById('username-input').value.trim();
            if(!username) {
                showToast('Please enter username', true);
                return;
            }
            document.getElementById('user-display-name').textContent = username.includes('@') ? username.split('@')[0] : username;
            
            // Transition to dashboard
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('main-app').classList.remove('hidden');
            showToast('Welcome to GuidePrep, ' + username + '!');
        }

        function handleGoogleLogin() {
            document.getElementById('user-display-name').textContent = 'Sagir Wani';
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('main-app').classList.remove('hidden');
            showToast('Successfully logged in with Google!');
        }

        function logout() {
            document.getElementById('main-app').classList.add('hidden');
            document.getElementById('auth-screen').classList.remove('hidden');
            showToast('Logged out successfully.');
        }

        // Tab Navigation
        function switchTab(tabId) {
            const tabs = ['dashboard', 'mcq', 'planner', 'progress', 'resources', 'settings'];
            tabs.forEach(t => {
                const view = document.getElementById('view-' + t);
                const nav = document.getElementById('nav-' + t);
                if (view) view.classList.add('hidden');
                if (nav) {
                    nav.className = 'sidebar-link flex items-center gap-3.5 px-4 py-3 rounded-xl font-medium text-sm text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all';
                }
            });

            const activeView = document.getElementById('view-' + tabId);
            const activeNav = document.getElementById('nav-' + tabId);
            if (activeView) activeView.classList.remove('hidden');
            if (activeNav) {
                activeNav.className = 'sidebar-link flex items-center gap-3.5 px-4 py-3 rounded-xl font-semibold text-sm transition-all bg-accentRed text-white shadow-[0_0_20px_rgba(255,30,30,0.4)]';
            }

            // Update top header title
            const titles = {
                'dashboard': 'Dashboard',
                'mcq': 'AI MCQ Practice',
                'planner': 'Study Management',
                'progress': 'My Progress',
                'resources': 'Notes & Resources',
                'settings': 'Settings'
            };
            document.getElementById('current-view-title').textContent = titles[tabId] || 'Dashboard';
        }

        function toggleMobileSidebar() {
            // For responsive toggle
            showToast('Sidebar navigation active');
        }

        // ==================== QUIZ RUNNER LOGIC ====================
        const quizData = [
            {
                q: "Which of the following is an example of a chemical change?",
                subject: "Science • Chemistry",
                options: ["Melting of ice", "Burning of paper", "Boiling of water", "Breaking of a glass"],
                correct: 1
            },
            {
                q: "What is the focal length of a plane mirror?",
                subject: "Science • Physics",
                options: ["Zero", "Infinity", "10 cm", "50 cm"],
                correct: 1
            },
            {
                q: "If sin θ = 3/5, what is the value of cos θ?",
                subject: "Mathematics • Trigonometry",
                options: ["4/5", "3/4", "5/3", "1/2"],
                correct: 0
            },
            {
                q: "Which gas is released during aerobic respiration?",
                subject: "Science • Biology",
                options: ["Oxygen", "Nitrogen", "Carbon Dioxide", "Hydrogen"],
                correct: 2
            },
            {
                q: "Who was the author of 'The Spirit of the Laws'?",
                subject: "Social Science • History",
                options: ["Rousseau", "Montesquieu", "Voltaire", "John Locke"],
                correct: 1
            }
        ];

        let currentQuizIndex = 0;
        let selectedOptionIndex = null;
        let quizScoreCount = 0;

        function loadQuizQuestion() {
            const item = quizData[currentQuizIndex];
            document.getElementById('quiz-q-number').textContent = 'Q' + (currentQuizIndex + 1);
            document.getElementById('quiz-question-text').textContent = item.q;
            document.getElementById('quiz-progress-fraction').textContent = (currentQuizIndex + 1) + ' / ' + quizData.length;

            const container = document.getElementById('quiz-options-container');
            container.innerHTML = '';

            item.options.forEach((opt, idx) => {
                const letter = String.fromCharCode(65 + idx); // A, B, C, D
                const isSelected = selectedOptionIndex === idx;
                const isCorrect = idx === item.correct;

                let borderClass = 'border-zinc-800 bg-black/40 hover:border-accentRed/60';
                let iconCharClass = 'w-7 h-7 rounded-full bg-zinc-900 border border-zinc-700 text-zinc-400 text-xs font-bold flex items-center justify-center mr-3';

                if (selectedOptionIndex !== null) {
                    if (isCorrect) {
                        borderClass = 'border-accentRed bg-accentRed/10 shadow-[0_0_15px_rgba(255,30,30,0.3)]';
                        iconCharClass = 'w-7 h-7 rounded-full bg-accentRed text-white text-xs font-bold flex items-center justify-center mr-3';
                    } else if (isSelected && !isCorrect) {
                        borderClass = 'border-red-900 bg-red-950/20';
                        iconCharClass = 'w-7 h-7 rounded-full bg-red-900 text-white text-xs font-bold flex items-center justify-center mr-3';
                    }
                }

                const div = document.createElement('div');
                div.className = `flex items-center justify-between p-4 rounded-2xl border ${borderClass} cursor-pointer transition-all`;
                div.onclick = () => selectQuizOption(idx);
                div.innerHTML = `
                    <div class="flex items-center">
                        <div class="${iconCharClass}">${letter}</div>
                        <span class="text-sm font-medium text-white">${opt}</span>
                    </div>
                    ${selectedOptionIndex !== null && isCorrect ? '<i class="fa-solid fa-check text-accentRed"></i>' : ''}
                `;
                container.appendChild(div);
            });
        }

        function selectQuizOption(idx) {
            selectedOptionIndex = idx;
            if (idx === quizData[currentQuizIndex].correct) {
                quizScoreCount++;
                showToast('Correct answer!');
            } else {
                showToast('Incorrect answer. Check correct highlight.', true);
            }
            loadQuizQuestion();
        }

        function nextQuizQuestion() {
            if (currentQuizIndex < quizData.length - 1) {
                currentQuizIndex++;
                selectedOptionIndex = null;
                loadQuizQuestion();
            } else {
                showToast('Quiz Completed! Great job!');
                currentQuizIndex = 0;
                selectedOptionIndex = null;
                loadQuizQuestion();
            }
        }

        function prevQuizQuestion() {
            if (currentQuizIndex > 0) {
                currentQuizIndex--;
                selectedOptionIndex = null;
                loadQuizQuestion();
            }
        }

        function resetQuiz() {
            currentQuizIndex = 0;
            selectedOptionIndex = null;
            quizScoreCount = 0;
            loadQuizQuestion();
            showToast('Quiz restarted.');
        }

        function setQuizClass(cls) {
            document.getElementById('class-btn-9').className = cls === '9' ? 'px-3 py-1.5 rounded-lg text-xs font-bold bg-accentRed text-white shadow-md' : 'px-3 py-1.5 rounded-lg text-xs font-bold text-zinc-400';
            document.getElementById('class-btn-10').className = cls === '10' ? 'px-3 py-1.5 rounded-lg text-xs font-bold bg-accentRed text-white shadow-md' : 'px-3 py-1.5 rounded-lg text-xs font-bold text-zinc-400';
            showToast('Switched to Class ' + cls + 'th Syllabus');
        }

        // ==================== STUDY PLANNER & TASKS ====================
        let tasksList = [
            { id: 1, title: 'Complete Physics Chapter - Light', subject: 'Physics', status: 'Done' },
            { id: 2, title: 'Revise Trigonometry (Math)', subject: 'Mathematics', status: 'Pending' },
            { id: 3, title: 'Solve 20 MCQs – Chemistry', subject: 'Chemistry', status: 'Pending' },
            { id: 4, title: 'Homework - Biology (Life Processes)', subject: 'Biology', status: 'Pending' }
        ];

        function renderTasks() {
            const container = document.getElementById('task-list-container');
            container.innerHTML = '';

            let completedCount = 0;

            tasksList.forEach(task => {
                if (task.status === 'Done') completedCount++;

                const isDone = task.status === 'Done';
                const badgeClass = isDone ? 'bg-emerald-500/20 border-emerald-500/40 text-emerald-400' : 'bg-amber-500/20 border-amber-500/40 text-amber-400';
                
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between p-4 bg-black/40 border border-zinc-800/80 rounded-2xl transition-all';
                div.innerHTML = `
                    <div class="flex items-center gap-3.5">
                        <input type="checkbox" ${isDone ? 'checked' : ''} onchange="toggleTaskStatus(${task.id})" class="w-5 h-5 rounded bg-black border-zinc-700 text-accentRed focus:ring-0 cursor-pointer">
                        <div>
                            <p class="text-sm font-semibold ${isDone ? 'line-through text-zinc-500' : 'text-white'}">${task.title}</p>
                            <span class="text-[10px] text-zinc-400">${task.subject}</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="px-3 py-1 rounded-full border text-[10px] font-bold ${badgeClass}">${task.status}</span>
                        <button onclick="deleteTask(${task.id})" class="text-zinc-600 hover:text-accentRed"><i class="fa-solid fa-trash text-xs"></i></button>
                    </div>
                `;
                container.appendChild(div);
            });

            document.getElementById('task-counter-badge').textContent = completedCount + '/' + tasksList.length + ' Completed';
        }

        function toggleTaskStatus(id) {
            const task = tasksList.find(t => t.id === id);
            if (task) {
                task.status = task.status === 'Done' ? 'Pending' : 'Done';
                renderTasks();
                showToast('Task updated: ' + task.title);
            }
        }

        function deleteTask(id) {
            tasksList = tasksList.filter(t => t.id !== id);
            renderTasks();
            showToast('Task deleted');
        }

        function openAddTaskModal() {
            document.getElementById('add-task-modal').classList.remove('hidden');
        }

        function closeAddTaskModal() {
            document.getElementById('add-task-modal').classList.add('hidden');
        }

        function handleAddTask(e) {
            e.preventDefault();
            const title = document.getElementById('new-task-title').value.trim();
            const subject = document.getElementById('new-task-subject').value;

            if (!title) return;

            tasksList.push({
                id: Date.now(),
                title: title,
                subject: subject,
                status: 'Pending'
            });

            document.getElementById('new-task-title').value = '';
            closeAddTaskModal();
            renderTasks();
            showToast('New task added successfully!');
        }

        // Initialize Weekly Calendar Bar
        function initCalendarBar() {
            const bar = document.getElementById('calendar-days-bar');
            const days = [
                { day: 'Mon', date: '13', active: false },
                { day: 'Tue', date: '14', active: false },
                { day: 'Wed', date: '15', active: true },
                { day: 'Thu', date: '16', active: false },
                { day: 'Fri', date: '17', active: false },
                { day: 'Sat', date: '18', active: false },
                { day: 'Sun', date: '19', active: false },
            ];

            bar.innerHTML = '';
            days.forEach(d => {
                const btn = document.createElement('div');
                btn.className = `flex flex-col items-center justify-center px-4 py-3 rounded-2xl cursor-pointer transition-all ${d.active ? 'bg-accentRed text-white shadow-[0_0_15px_rgba(255,30,30,0.5)] border border-accentRed' : 'bg-black/50 border border-zinc-800 text-zinc-400 hover:border-zinc-700'}`;
                btn.onclick = () => showToast('Switched to ' + d.day + ' ' + d.date + ' schedule');
                btn.innerHTML = `
                    <span class="text-[10px] font-bold uppercase tracking-wider">${d.day}</span>
                    <span class="text-base font-black mt-0.5">${d.date}</span>
                `;
                bar.appendChild(btn);
            });
        }

        // On window load initialization
        window.onload = function() {
            loadQuizQuestion();
            renderTasks();
            initCalendarBar();
        }
    </script>
</body>
</html>
